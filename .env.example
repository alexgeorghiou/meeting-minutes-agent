# Copy to .env and fill in what you need. Everything defaults to offline fakes.

# LLM: fake | anthropic | openai
MINUTES_LLM_PROVIDER=fake
# MINUTES_LLM_MODEL=claude-sonnet-4-5
# MINUTES_ANTHROPIC_API_KEY=
# MINUTES_OPENAI_API_KEY=

# Transcription: fake | openai | local (faster-whisper, needs the [local] extra)
MINUTES_TRANSCRIBER=fake
# MINUTES_WHISPER_MODEL=whisper-1
# MINUTES_LOCAL_WHISPER_MODEL=small

# Jobs: memory | sqlite
MINUTES_JOB_STORE=memory

# GitHub Issues export
# MINUTES_GITHUB_TOKEN=
# MINUTES_GITHUB_REPO=owner/name

# Jira Cloud export
# MINUTES_JIRA_BASE_URL=https://your-site.atlassian.net
# MINUTES_JIRA_EMAIL=
# MINUTES_JIRA_API_TOKEN=
# MINUTES_JIRA_PROJECT_KEY=
